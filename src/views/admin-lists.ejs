<!DOCTYPE html>
<html lang="ru" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Списки моделей — AI Model Catalog</title>
  <%- include('partials/theme-init') %>
  <%- include('partials/favicon') %>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="admin-page lists-admin-page">
  <%- include('partials/nav', { activeNav: 'admin' }) %>

  <%- include('partials/admin-layout-open', { activeAdminNav: 'lists' }) %>
    <%- include('partials/admin-user-bar') %>

    <div class="page-title-row">
      <h1 class="page-title">Списки моделей</h1>
    </div>
    <p class="page-subtitle">Коллекции моделей под конкретные задачи: название, описание и состав.</p>

    <div class="providers-toolbar">
      <label class="providers-search">
        <span class="providers-search__icon" aria-hidden="true">⌕</span>
        <input type="search" id="listsSearch" placeholder="Поиск по названию…" autocomplete="off">
      </label>
      <a href="/admin/lists/new" class="btn btn-primary">Создать список</a>
    </div>

    <p id="listsStatus" class="form-status providers-status" hidden></p>

    <% if (!lists.length) { %>
      <div class="page-card providers-empty" id="listsEmpty">
        <p class="detail-empty">Списков пока нет. Создайте первый для подборки моделей.</p>
        <a href="/admin/lists/new" class="btn btn-primary">Создать список</a>
      </div>
    <% } else { %>
      <div class="providers-grid" id="listsGrid">
        <% for (const list of lists) { %>
          <% const searchText = [list.name, list.description].join(' ').toLowerCase(); %>
          <article
            class="provider-card"
            data-list-id="<%= list.id %>"
            data-search-text="<%= searchText %>"
          >
            <header class="provider-card__header">
              <h2 class="provider-card__title"><%= list.name %></h2>
            </header>
            <% if (list.description) { %>
              <p class="provider-card__desc muted"><%= list.description.length > 160 ? list.description.slice(0, 157) + '…' : list.description %></p>
            <% } %>
            <footer class="provider-card__footer">
              <span><%= list.itemCount %> <%= list.itemCount === 1 ? 'модель' : (list.itemCount >= 2 && list.itemCount <= 4 ? 'модели' : 'моделей') %></span>
              <a href="/lists?id=<%= list.id %>" class="muted">Открыть</a>
            </footer>
            <div class="provider-card__actions">
              <a href="/admin/lists/<%= list.id %>/edit" class="btn btn-secondary btn-sm">Изменить</a>
              <button
                type="button"
                class="btn btn-danger btn-sm"
                data-delete-list="<%= list.id %>"
                data-list-name="<%= list.name %>"
              >Удалить</button>
            </div>
          </article>
        <% } %>
      </div>

      <div class="page-card providers-empty providers-empty--search" id="listsSearchEmpty" hidden>
        <p class="detail-empty">Ничего не найдено. Попробуйте другой запрос.</p>
      </div>
    <% } %>
  <%- include('partials/admin-layout-close') %>

  <script src="/authFetch.js"></script>
  <script src="/lists-admin.js"></script>
</body>
</html>
