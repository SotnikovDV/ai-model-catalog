<!DOCTYPE html>
<html lang="ru" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Model Catalog — Справочник моделей</title>
  <%- include('partials/theme-init') %>
  <%- include('partials/favicon') %>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('partials/nav', { showStats: true, totalCount, shownCount, activeNav: 'catalog', showFilterLink: true, showAddModelLink: true }) %>

  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <div class="layout">
    <%- include('partials/sidebar') %>

    <main class="main">
      <div class="rec-banner" id="recBanner" hidden></div>
      <div class="toolbar">
        <div class="result-count">
          Найдено: <strong id="filteredCount"><%= shownCount %></strong> моделей
        </div>
        <a
          href="/models/new"
          class="btn btn-secondary toolbar-add-btn desktop-only"
          aria-label="Добавить модель"
          title="Добавить модель"
        >
          <svg class="toolbar-add-btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 8v8M8 12h8"/>
          </svg>
          <span class="toolbar-add-btn-label">Добавить модель</span>
        </a>
        <button
          type="button"
          class="toolbar-filter-btn"
          id="filterOpenBtn"
          aria-label="Открыть фильтры"
          title="Фильтр"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
          </svg>
        </button>
        <select class="sort-select" id="sortSelect">
          <option value="default">По умолчанию</option>
          <option value="name_asc">Название А→Я</option>
          <option value="name_desc">Название Я→А</option>
          <option value="price_asc">Цена ↑</option>
          <option value="price_desc">Цена ↓</option>
          <option value="context_desc">Контекст ↓</option>
          <option value="context_asc">Контекст ↑</option>
          <option value="release_desc">Релиз ↓</option>
          <option value="release_asc">Релиз ↑</option>
          <option value="chat_rating_desc">Оценка ↓</option>
          <option value="chat_rating_asc">Оценка ↑</option>
        </select>
        <div class="view-toggle">
          <button type="button" class="view-btn active" id="gridViewBtn" title="Сетка">⊞</button>
          <button type="button" class="view-btn" id="listViewBtn" title="Список">☰</button>
        </div>
        <button
          type="button"
          class="toolbar-bulk-menu-btn"
          id="bulkSelectionMenuBtn"
          title="Действия с выбранными"
          aria-label="Действия с выбранными моделями"
          aria-haspopup="menu"
          aria-expanded="false"
          disabled
        >⋮</button>
      </div>

      <div class="active-filters" id="activeFilters"></div>
      <div class="cards-grid" id="cardsGrid"></div>
      <div class="pagination" id="pagination"></div>
    </main>
  </div>

  <div class="modal-overlay" id="modalOverlay">
    <div class="modal" id="modalBox">
      <div class="modal-header">
        <div class="modal-header-top">
          <div class="modal-header-main">
            <div class="modal-title-row">
              <div class="modal-model-name" id="mName"></div>
              <button type="button" class="rec-copy-name-btn" id="mCopyNameBtn" title="Копировать название" aria-label="Копировать название" hidden>
                <svg class="rec-copy-name-icon" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
            <div class="modal-developer" id="mDeveloper"></div>
            <div class="modal-badges" id="mBadges"></div>
            <div class="modal-updated" id="mUpdated"></div>
            <div class="modal-header-actions card-actions" id="mActionsSection">
              <a href="#" class="card-detail-btn" id="mDetailLink" title="Подробнее" aria-label="Подробнее">
                <svg class="card-action-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              </a>
              <a href="#" class="card-chat-btn" id="mChatLink" title="Чат с моделью" aria-label="Чат с моделью">
                <svg class="card-action-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </a>
              <a href="#" class="card-edit-btn" id="mEditLink" title="Редактировать модель" aria-label="Редактировать модель">✎</a>
              <button type="button" class="card-hidden-btn" id="mHiddenBtn" title="Скрыть модель" aria-label="Скрыть модель"></button>
              <button type="button" class="card-favorite-btn" id="mFavoriteBtn" title="Добавить в избранное" aria-label="Добавить в избранное">★</button>
              <button type="button" class="card-compare-btn" id="mCompareBtn" title="Добавить к сравнению" aria-label="Добавить к сравнению" aria-pressed="false">
                <span class="compare-btn-icon" aria-hidden="true"></span>
              </button>
            </div>
          </div>
          <div class="modal-close" id="modalClose" title="Закрыть">×</div>
        </div>
      </div>
      <div class="modal-body">
        <div class="modal-section">
          <div class="modal-section-title">О модели</div>
          <div class="modal-description chat-message-content--markdown" id="mDescription"></div>
        </div>
        <div class="modal-section">
          <div class="modal-section-title">Технические характеристики</div>
          <div class="modal-specs-grid" id="mSpecs"></div>
        </div>
        <div class="modal-section" id="mStrengthsSection">
          <div class="modal-section-title">Сильные стороны</div>
          <ul class="modal-list" id="mStrengths"></ul>
        </div>
        <div class="modal-section" id="mBestForSection">
          <div class="modal-section-title">Лучше всего подходит для</div>
          <ul class="modal-list" id="mBestFor"></ul>
        </div>
        <div class="modal-section" id="mLimitsSection">
          <div class="modal-section-title">Особенности и ограничения</div>
          <ul class="modal-list limits" id="mLimits"></ul>
        </div>
        <div class="modal-section" id="mCatsSection">
          <div class="modal-section-title">Сценарии использования</div>
          <div class="modal-cats" id="mCats"></div>
        </div>
      </div>
    </div>
  </div>

  <div id="bulkSelectionMenu" class="card-context-menu" hidden>
    <div class="card-menu-group">
      <div class="card-menu-group-title">Выбрать</div>
      <button type="button" class="card-menu-item card-menu-subitem" data-action="select-all">Все на странице</button>
      <button type="button" class="card-menu-item card-menu-subitem" data-action="select-all-filtered">Все в списке</button>
      <button type="button" class="card-menu-item card-menu-subitem" data-action="clear-compare">Очистить список</button>
    </div>
    <div class="card-menu-separator" role="separator"></div>
    <div class="card-menu-group">
      <div class="card-menu-group-title">Избранное</div>
      <button type="button" class="card-menu-item card-menu-subitem" data-action="favorite-add">Добавить</button>
      <button type="button" class="card-menu-item card-menu-subitem" data-action="favorite-remove">Удалить</button>
    </div>
    <div class="card-menu-group">
      <div class="card-menu-group-title">Скрытое</div>
      <button type="button" class="card-menu-item card-menu-subitem" data-action="hidden-set">Установить</button>
      <button type="button" class="card-menu-item card-menu-subitem" data-action="hidden-unset">Отменить</button>
    </div>
    <div class="card-menu-separator" role="separator"></div>
    <div class="card-menu-group">
      <div class="card-menu-group-title">Доступность</div>
      <button type="button" class="card-menu-item card-menu-subitem" data-action="availability-catalog">Быстрая проверка</button>
      <button type="button" class="card-menu-item card-menu-subitem" data-action="availability-inference">Проверка inference</button>
    </div>
    <div class="card-menu-group">
      <div class="card-menu-group-title">Оценка</div>
      <button type="button" class="card-menu-item card-menu-subitem" data-action="evaluate-benchmark">Автооценка (бенчмарк)</button>
    </div>
    <div class="card-menu-separator" role="separator"></div>
    <button type="button" class="card-menu-item" data-action="update">Запросить обновление</button>
    <div class="card-menu-separator" role="separator"></div>
    <button type="button" class="card-menu-item card-menu-danger" data-action="delete">Удалить</button>
  </div>

  <div class="modal-overlay" id="bulkSyncOverlay">
    <div class="modal sync-modal" role="dialog" aria-labelledby="bulkSyncTitle">
      <div class="modal-header">
        <div class="modal-header-top">
          <div class="modal-header-text">
            <h2 class="modal-title" id="bulkSyncTitle">Обновление моделей</h2>
            <p class="sync-modal-model-name" id="bulkSyncCount">Выбрано: 0</p>
          </div>
          <button type="button" class="modal-close" id="bulkSyncClose" aria-label="Закрыть">&times;</button>
        </div>
      </div>
      <div class="modal-body">
        <p class="sync-modal-intro">
          Данные загружаются из BotHub, OpenRouter и RouterAI.
          Группы с меткой <span class="sync-ai-badge">AI</span> дополнительно обогащаются через настроенный AI-провайдер.
        </p>
        <div class="sync-preset-row">
          <span class="sync-preset-label">Быстрый выбор:</span>
          <button type="button" class="btn btn-secondary btn-sm" id="bulkSyncPresetCatalog">Каталоги</button>
          <button type="button" class="btn btn-secondary btn-sm" id="bulkSyncPresetWithAi">С AI</button>
          <button type="button" class="btn btn-secondary btn-sm" id="bulkSyncPresetAll">Снять все</button>
        </div>
        <label class="form-check-inline sync-only-empty" for="bulkSyncOnlyEmpty">
          <input type="checkbox" id="bulkSyncOnlyEmpty" value="1">
          Только пустые поля
        </label>
        <div class="sync-fields-header sync-fields-header--compact">Группы полей</div>
        <div id="bulkSyncFieldGroups" class="sync-group-toggles"></div>
        <div id="bulkSyncProgress" class="sync-progress" hidden aria-live="polite"></div>
        <p id="bulkSyncStatus" class="form-status" hidden></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" id="bulkSyncCancelBtn">Отмена</button>
        <button type="button" class="btn btn-primary" id="bulkSyncApplyBtn">Обновить</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="bulkAvailabilityOverlay">
    <div class="modal sync-modal" role="dialog" aria-labelledby="bulkAvailabilityTitle">
      <div class="modal-header">
        <div class="modal-header-top">
          <div class="modal-header-text">
            <h2 class="modal-title" id="bulkAvailabilityTitle">Проверка доступности</h2>
            <p class="sync-modal-model-name" id="bulkAvailabilityCount">Выбрано: 0</p>
          </div>
          <button type="button" class="modal-close" id="bulkAvailabilityClose" aria-label="Закрыть">&times;</button>
        </div>
      </div>
      <div class="modal-body">
        <p class="sync-modal-intro" id="bulkAvailabilityIntro"></p>
        <div id="bulkAvailabilityProgress" class="sync-progress" hidden aria-live="polite"></div>
        <p id="bulkAvailabilityStatus" class="form-status" hidden></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" id="bulkAvailabilityApplyBtn">Запустить</button>
        <button type="button" class="btn btn-secondary" id="bulkAvailabilityCancelBtn">Отмена</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="bulkEvaluationOverlay">
    <div class="modal sync-modal" role="dialog" aria-labelledby="bulkEvaluationTitle">
      <div class="modal-header">
        <div class="modal-header-top">
          <div class="modal-header-text">
            <h2 class="modal-title" id="bulkEvaluationTitle">Автооценка моделей</h2>
            <p class="sync-modal-model-name" id="bulkEvaluationCount">Выбрано: 0</p>
          </div>
          <button type="button" class="modal-close" id="bulkEvaluationClose" aria-label="Закрыть">&times;</button>
        </div>
      </div>
      <div class="modal-body">
        <p class="sync-modal-intro" id="bulkEvaluationIntro">
          Бенчмарк из 5 критериев через chat-запрос к провайдеру (~сотни токенов на модель).
          Результат сохраняется в оценку чата; при ответе модели — статус «Инференс».
        </p>
        <div id="bulkEvaluationProgress" class="sync-progress" hidden aria-live="polite"></div>
        <p id="bulkEvaluationStatus" class="form-status" hidden></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" id="bulkEvaluationApplyBtn">Запустить</button>
        <button type="button" class="btn btn-secondary" id="bulkEvaluationCancelBtn">Отмена</button>
      </div>
    </div>
  </div>

  <script>
    window.MODELS_DATA = <%- JSON.stringify(models).replace(/</g, '\\u003c') %>;
    window.USE_CASE_CATEGORIES = <%- JSON.stringify(useCaseCategories).replace(/</g, '\\u003c') %>;
  </script>
  <%- include('partials/admin-auth-init') %>
  <script src="https://cdn.jsdelivr.net/npm/marked@15.0.7/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.5/dist/purify.min.js"></script>
  <script src="/markdown.js"></script>
  <script src="/catalog.js"></script>
  <script src="/app.js"></script>
</body>
</html>
