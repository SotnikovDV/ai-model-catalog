PORT=3000
DB_PATH=./data/models.db

# OpenAI-совместимый AI-провайдер (опционально, можно настроить в админке)
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_SIMPLE=gpt-4o-mini
AI_MODEL_ANALYTICS=gpt-4o

# Модель с поиском в интернете (опционально; независимый провайдер)
# AI_SEARCH_BASE_URL по умолчанию — Perplexity; пустой AI_SEARCH_API_KEY → основной AI_API_KEY
AI_SEARCH_BASE_URL=https://api.perplexity.ai
AI_SEARCH_API_KEY=
AI_MODEL_SEARCH=

# BotHub REST API v2 — баланс в шапке (только для админа)
# Вариант 1: email + пароль (signin → JWT)
BOTHUB_EMAIL=
BOTHUB_PASSWORD=
# Вариант 2: готовый JWT (например developer access token)
BOTHUB_ACCESS_TOKEN=

# Админка (опционально; если ADMIN_PASSWORD пуст — auth отключён)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Сессии входа (если не задан — используется ADMIN_PASSWORD)
SESSION_SECRET=
SESSION_MAX_AGE_SEC=604800
# COOKIE_SECURE=true

# Rate limiting (запросов за 15 минут)
AI_RATE_LIMIT_MAX=60
SYNC_RATE_LIMIT_MAX=10

# Бэкап SQLite (локально по умолчанию выкл.)
BACKUP_ENABLED=false
BACKUP_DIR=./backups
BACKUP_HOUR=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
