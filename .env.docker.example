# Шаблон для Docker / Synology NAS
# Скопируйте: cp .env.docker.example .env

PORT=3000
DB_PATH=/app/data/models.db

# OpenAI-совместимый AI-провайдер (опционально, можно настроить в админке)
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_SIMPLE=gpt-4o-mini
AI_MODEL_ANALYTICS=gpt-4o

# Админка — ОБЯЗАТЕЛЬНО задать на production
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-strong-password

# Сессии входа — задайте длинную случайную строку
SESSION_SECRET=change-me-to-long-random-string
SESSION_MAX_AGE_SEC=604800

# HTTP по локальной сети (без HTTPS):
# COOKIE_SECURE=false
#
# HTTPS через Synology Reverse Proxy:
# COOKIE_SECURE=true

# Rate limiting (запросов за 15 минут)
AI_RATE_LIMIT_MAX=60
SYNC_RATE_LIMIT_MAX=10

# За Synology Reverse Proxy (иначе express-rate-limit ругается на X-Forwarded-For):
# TRUST_PROXY=1
