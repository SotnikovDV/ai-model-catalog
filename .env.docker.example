# Шаблон для Docker / Synology NAS
# Скопируйте: cp .env.docker.example .env

PORT=3000
DB_PATH=/app/data/models.db

# OpenAI-совместимый AI-провайдер (опционально, можно настроить в админке)
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL_SIMPLE=gpt-4o-mini
AI_MODEL_ANALYTICS=gpt-4o

# Модель с поиском в интернете (опционально; независимый провайдер)
# AI_SEARCH_BASE_URL по умолчанию — Perplexity; пустой AI_SEARCH_API_KEY → основной AI_API_KEY
AI_SEARCH_BASE_URL=https://api.perplexity.ai
AI_SEARCH_API_KEY=
AI_MODEL_SEARCH=

# BotHub REST API v2 — баланс Caps в шапке (только для админа)
BOTHUB_EMAIL=
BOTHUB_PASSWORD=
BOTHUB_ACCESS_TOKEN=

# Админка — ОБЯЗАТЕЛЬНО задать на production
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-strong-password

# Сессии входа — задайте длинную случайную строку
# Как получить SESSION_SECRET:
#   В Linux/macOS:
#     openssl rand -base64 48
#   В Windows (PowerShell):
#     [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET=change-me-to-long-random-string
SESSION_MAX_AGE_SEC=604800

# HTTP по локальной сети (без HTTPS):
# COOKIE_SECURE=false
#
# HTTPS через Synology Reverse Proxy:
# COOKIE_SECURE=true

# Rate limiting (запросов за 15 минут)
AI_RATE_LIMIT_MAX=60
SYNC_RATE_LIMIT_MAX=10

# За Synology Reverse Proxy (иначе express-rate-limit ругается на X-Forwarded-For):
# TRUST_PROXY=1

# Бэкап SQLite (volume ./backups; TZ задаётся в docker-compose)
BACKUP_ENABLED=true
BACKUP_DIR=/app/backups
BACKUP_HOUR=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
